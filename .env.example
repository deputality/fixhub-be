# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Адрес фронтенда: сюда ведут ссылки из писем
APP_BASE_URL=http://localhost:5173

# Почта для писем (сброс пароля и уведомления). Пока SMTP_HOST пустой, письма не отправляются,
# а ссылка для сброса пароля пишется в лог: docker compose logs api
# Пример для Gmail: нужен пароль приложения, а не обычный пароль от почты
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=app-password
SMTP_FROM=your.address@gmail.com
