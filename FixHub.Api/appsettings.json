{
    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=fixhub;Username=fixhub;Password=fixhub123"
    },
    "Jwt": {
        "Key": "fixhub-super-secret-key-change-me-0123456789",
        "Issuer": "FixHub.Api",
        "Audience": "FixHub.Client",
        "ExpiresMinutes": 120
    },
    "Admin": {
        "Email": "admin@fixhub.local",
        "Password": "Admin12345"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/fixhub-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*"
}